diff --git a/openwakeword/data.py b/openwakeword/data.py
index 7a95306..6a3ae77 100755
--- a/openwakeword/data.py
+++ b/openwakeword/data.py
@@ -886,8 +886,21 @@ def trim_mmap(mmap_path):
             mmap_file2.flush()
 
     # Remove old mmaped file
+    # NOTE: patched -- Windows keeps the file locked while a numpy memmap
+    # handle is open (unlike POSIX), so os.remove() fails with
+    # PermissionError unless the mmap is explicitly released first. `del`
+    # alone isn't reliable here (numpy.memmap's internal refs need the
+    # cyclic GC, not just refcounting), so force collection too.
+    del mmap_file1
+    import gc
+    gc.collect()
     os.remove(mmap_path)
 
+    # mmap_file2 (opened 'w+' above) must also be released before renaming it
+    # -- same Windows file-lock issue as mmap_file1 above.
+    del mmap_file2
+    gc.collect()
+
     # Rename new mmap file to match original
     os.rename(output_file2, mmap_path)
 
